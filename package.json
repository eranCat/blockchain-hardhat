{
  "name": "blockchain-hardhat",
  "version": "1.0.0",
  "description": "Elections 2025 DApp with Anonymous Voting",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deployAndStartElection.ts --network hardhat",
    "deploy:sepolia": "hardhat run scripts/deployAndStartElection.ts --network sepolia",
    "generate-proofs": "node --import tsx scripts/generateProofs.ts",
    "extract-abi": "node --import tsx scripts/extractABI.ts",
    "set-root": "hardhat run scripts/setRoot.ts --network hardhat",
    "set-root:sepolia": "hardhat run scripts/setRoot.ts --network sepolia",
    "setup-candidates": "hardhat run scripts/example-candidates-setup.ts --network hardhat",
    "setup-candidates:sepolia": "hardhat run scripts/example-candidates-setup.ts --network sepolia",
    "vote": "hardhat run scripts/directVoteSepolia.ts --network sepolia",
    "check-status": "node --import tsx scripts/fetchElectionStatusNode.ts",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/merkle-tree": "^1.0.5",
    "@types/node": "^22.10.2",
    "hardhat": "^2.22.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "viem": "^2.7.0"
  }
}